# Store text files with LF line endings in the repo and in the working copy, whatever editor or OS writes them,
# so a tool switching between CRLF and LF doesn't show every line of a file as changed.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files: never convert line endings or diff as text
*.zip binary
*.pdf binary
*.xlsx binary
*.xls binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pmtiles binary
